# Sanity Studio configuration. Safe to share — these are a public address,
# not credentials.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Write token used ONLY by `npm run seed` to push the initial content and
# upload images. Create one at sanity.io/manage -> your project -> API ->
# Tokens (Editor). Never commit the real value, never prefix it with
# SANITY_STUDIO_ (that would ship it to the browser).
SANITY_API_TOKEN=

# Sanity — build-time only, NOT VITE_ prefixed (never reaches the browser bundle).
# projectId + dataset are a public address, not a credential. Safe to commit.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-01

# NOTE: VITE_WEB3FORMS_KEY is gone. Both forms now post to our own functions
# (/api/inquiry and /api/apply), which record to Sanity first and then notify
# via Resend. Nothing reads a Web3Forms key any more — remove it from Vercel.

# --- Careers application form (/api/apply) -------------------------------
# Server-side only. Set these in the Vercel dashboard, NOT here, and never
# with a VITE_ prefix — anything VITE_ prefixed is inlined into the browser
# bundle and is therefore public.

# Sanity token with write access. sanity.io/manage -> API -> Tokens (Editor).
# SECRET. Lets /api/apply upload CVs and create `application` documents.
SANITY_WRITE_TOKEN=

# Resend API key. SECRET. resend.com -> API Keys. Free tier is 3,000 emails
# a month and includes attachments, which is why the careers form uses Resend
# rather than Web3Forms (attachments are PRO-only there, so the CV could only
# be linked). The inquiry modal still uses VITE_WEB3FORMS_KEY above.
RESEND_API_KEY=

# Where careers notifications are delivered. Changing the destination is just
# this value plus a redeploy — no code change.
CAREERS_NOTIFY_EMAIL=

# Where LET'S TALK campaign inquiries are delivered. Separate from the careers
# inbox so sales leads and job applications stay apart, and either can move
# without touching the other. Long term this is ceo@wearestreetbuzz.com, where
# the old Web3Forms key delivered — but while Resend is on its sandbox sender
# it can only deliver to your own Resend account address.
INQUIRY_NOTIFY_EMAIL=

# Optional. The From address, which must be on a domain verified in Resend.
# Defaults to "StreetBuzz Careers <careers@wearestreetbuzz.com>". Point this at
# Resend's sandbox sender while the domain's DNS records are still pending.
RESEND_FROM=

# Sanity read token. Only needed once the dataset is switched to private,
# which it SHOULD be: applications hold applicant names, emails and phone
# numbers, and a public dataset lets anyone query them. SECRET.
SANITY_READ_TOKEN=

# Sanity — build-time only, NOT VITE_ prefixed (never reaches the browser bundle).
# projectId + dataset are a public address, not a credential. Safe to commit.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-01

# Web3Forms access key. Public by design — it identifies a destination inbox,
# it does not authorize anything.
VITE_WEB3FORMS_KEY=

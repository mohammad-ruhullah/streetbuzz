# Sanity — build-time only, NOT VITE_ prefixed (never reaches the browser bundle).
# projectId + dataset are a public address, not a credential. Safe to commit.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-01

# Web3Forms access key. Public by design — it identifies a destination inbox,
# it does not authorize anything.
VITE_WEB3FORMS_KEY=

# --- Careers application form (/api/apply) -------------------------------
# Server-side only. Set these in the Vercel dashboard, NOT here, and never
# with a VITE_ prefix — anything VITE_ prefixed is inlined into the browser
# bundle and is therefore public.

# Sanity token with write access. sanity.io/manage -> API -> Tokens (Editor).
# SECRET. Lets /api/apply upload CVs and create `application` documents.
SANITY_WRITE_TOKEN=

# Web3Forms key for the careers inbox. A key IS its destination, so this must
# be a NEW key created for mohammad.ruhullah16@gmail.com — the existing
# VITE_WEB3FORMS_KEY above delivers to ceo@wearestreetbuzz.com and cannot be
# redirected.
WEB3FORMS_CAREERS_KEY=

# Sanity read token. Only needed once the dataset is switched to private,
# which it SHOULD be: applications hold applicant names, emails and phone
# numbers, and a public dataset lets anyone query them. SECRET.
SANITY_READ_TOKEN=

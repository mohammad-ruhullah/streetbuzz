{
  "name": "streetbuzz-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000",
    "sync": "node scripts/sync-content.mjs",
